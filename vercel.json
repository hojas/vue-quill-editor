{
  "buildCommand": "pnpm install && pnpm build:demo",
  "outputDirectory": "demo-dist",
  "rewrites": [
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/edm/upload.ts": {
      "includeFiles": "lib/**"
    },
    "api/edm/[id]/download.ts": {
      "includeFiles": "lib/**"
    }
  }
}
