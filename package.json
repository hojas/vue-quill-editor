{
  "name": "vue-quill-editor-edm",
  "type": "module",
  "version": "0.1.0",
  "description": "Vue 3 + Quill 2.0 rich text editor with EDM (image/video/file) upload and preview extensions.",
  "license": "MIT",
  "keywords": [
    "vue",
    "quill",
    "rich-text-editor",
    "edm",
    "image-upload",
    "video-upload",
    "file-upload",
    "wysiwyg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-quill-editor-edm.js",
      "require": "./dist/vue-quill-editor-edm.cjs"
    }
  },
  "main": "./dist/vue-quill-editor-edm.cjs",
  "module": "./dist/vue-quill-editor-edm.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "rm -rf dist && vue-tsc --project tsconfig.build.json && vite build",
    "build:demo": "vue-tsc --project tsconfig.build.json && vite build --config vite.demo.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview --host 127.0.0.1"
  },
  "peerDependencies": {
    "quill": "^2.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.1",
    "quill": "2.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.2"
  }
}
